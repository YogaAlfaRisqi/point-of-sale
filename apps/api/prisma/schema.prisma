generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  phone         String?
  avatar        String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  username      String         @unique
  notifications Notification[]
  orders        Order[]
  bookings      TableBooking[]
  userRoles     UserRole[]

  @@index([email])
  @@index([username])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  menus       Menu[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Menu {
  id              String          @id @default(cuid())
  categoryId      String
  name            String
  description     String?
  price           Decimal         @db.Decimal(10, 2)
  imageUrl        String?
  isAvailable     Boolean         @default(true)
  preparationTime Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  menuInventory   MenuInventory[]
  category        Category        @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]

  @@index([categoryId])
  @@index([isAvailable])
  @@index([name])
  @@map("menus")
}

model Inventory {
  id            String          @id @default(cuid())
  name          String
  unit          String
  quantity      Decimal         @db.Decimal(10, 3)
  minStock      Decimal         @default(0) @db.Decimal(10, 3)
  description   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  code          String          @unique
  costPrice     Decimal         @db.Decimal(10, 2)
  supplierId    String?
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  menuInventory MenuInventory[]
  stockHistory  StockHistory[]

  @@index([code])
  @@index([supplierId])
  @@map("inventory")
}

model Supplier {
  id          String      @id @default(cuid())
  name        String
  contact     String?
  phone       String?
  email       String?
  address     String?
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  inventory   Inventory[]

  @@index([name])
  @@index([isActive])
  @@map("suppliers")
}

model MenuInventory {
  id             String    @id @default(cuid())
  menuId         String
  inventoryId    String
  quantityNeeded Decimal   @db.Decimal(10, 3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  inventory      Inventory @relation(fields: [inventoryId], references: [id])
  menu           Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, inventoryId])
  @@index([menuId])
  @@index([inventoryId])
  @@map("menu_inventory")
}

model StockHistory {
  id          String    @id @default(cuid())
  inventoryId String
  type        String
  quantity    Decimal   @db.Decimal(10, 3)
  beforeQty   Decimal   @db.Decimal(10, 3)
  afterQty    Decimal   @db.Decimal(10, 3)
  reference   String?
  notes       String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_history")
}

model Table {
  id          String         @id @default(cuid())
  tableNumber String         @unique
  capacity    Int
  status      TableStatus    @default(AVAILABLE)
  floor       String?
  description String?
  qrCode      String?        @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  isActive    Boolean        @default(true)
  location    String?
  orders      Order[]
  bookings    TableBooking[]

  @@index([status])
  @@index([isActive])
  @@index([tableNumber])
  @@map("tables")
}

model TableBooking {
  id            String        @id @default(cuid())
  tableId       String
  userId        String
  bookingDate   DateTime
  guestCount    Int
  status        BookingStatus @default(PENDING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  bookingNumber String        @unique @default(cuid())
  bookingTime   String
  cancelReason  String?
  cancelledAt   DateTime?
  customerEmail String?
  customerName  String
  customerPhone String
  duration      Int
  table         Table         @relation(fields: [tableId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@index([tableId])
  @@index([userId])
  @@index([bookingDate])
  @@index([status])
  @@index([bookingNumber])
  @@map("table_bookings")
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique @default(cuid())
  userId        String
  tableId       String?
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @default(0) @db.Decimal(10, 2)
  tax           Decimal     @default(0) @db.Decimal(10, 2)
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  total         Decimal     @default(0) @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  cancelReason  String?
  cancelledAt   DateTime?
  completedAt   DateTime?
  customerName  String?
  customerPhone String?
  discountRate  Decimal     @default(0) @db.Decimal(5, 2)
  orderType     String      @default("DINE_IN")
  serviceCharge Decimal     @default(0) @db.Decimal(10, 2)
  taxRate       Decimal     @default(0) @db.Decimal(5, 2)
  orderItems    OrderItem[]
  table         Table?      @relation(fields: [tableId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  payment       Payment?

  @@index([userId])
  @@index([tableId])
  @@index([status])
  @@index([orderType])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  menuId    String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime @default(now())
  menuName  String
  menu      Menu     @relation(fields: [menuId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuId])
  @@map("order_items")
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(10, 2)
  transactionId   String?       @unique
  qrisData        String?
  cardNumber      String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  accountNumber   String?
  bankName        String?
  cardType        String?
  changeAmount    Decimal       @default(0) @db.Decimal(10, 2)
  ewalletProvider String?
  notes           String?
  paidAmount      Decimal       @default(0) @db.Decimal(10, 2)
  paymentNumber   String        @unique @default(cuid())
  referenceNumber String?
  order           Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([transactionId])
  @@index([paymentNumber])
  @@map("payments")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())
  actionUrl String?
  expiresAt DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("STRING")
  category    String   @default("GENERAL")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([category])
  @@map("system_config")
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
  E_WALLET
  BANK_TRANSFER
  DEBIT_CARD
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  ORDER
  PAYMENT
  BOOKING
  SYSTEM
  PROMOTION
}
